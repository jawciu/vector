# Copy to .env and set your values.

# Postgres (Supabase recommended)
#   Supabase: Project Settings → Database → Connection string (URI). Use pooler for serverless.
#   Example: postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/onboarding"

# Supabase Auth (same project as DB: Project Settings → API)
#   Project URL and anon (or publishable) key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# App public URL — used to build portal URLs in invite emails.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (optional — if unset, emails log to the server console instead of sending)
#   API key: resend.com → API Keys
#   EMAIL_FROM must use a verified domain in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Vector <onboarding@example.com>"

# Anthropic API — powers the Vector AI features (insights, transcript drafts).
#   Get a key at: console.anthropic.com → Settings → API Keys
#   Required for any AI feature; the streaming Insights tab will fail without it.
ANTHROPIC_API_KEY=""

# Miniti webhook — token query param protecting /api/integrations/miniti/webhook.
# Generate a long random string (e.g. `openssl rand -hex 32`) and paste the
# *full* URL with `?token=<value>` into Miniti → Settings → Webhook URL.
# Per Ian's spec there's no HMAC signing, so the URL itself is the secret.
MINITI_WEBHOOK_TOKEN=""
