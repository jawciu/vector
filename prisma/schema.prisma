// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          Int           @id @default(autoincrement())
  name        String
  onboardings Onboarding[]
}

model VendorUser {
  id               Int          @id @default(autoincrement())
  authUserId       String?      @unique
  email            String       @unique
  name             String
  role             String       @default("admin") // admin | member | viewer
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  ownedOnboardings Onboarding[]
  ownedTasks       Task[]
}

model Onboarding {
  id            Int          @id @default(autoincrement())
  companyId     Int
  owner         String       @default("")
  ownerId       Int?
  ownerUser     VendorUser?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status        String       @default("Active") // Active | Completed | Paused | Archived
  targetGoLive  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks         Task[]
  contacts      Contact[]
  phases        Phase[]
  magicLinks    MagicLink[]
  files         File[]
}

model Contact {
  id            Int          @id @default(autoincrement())
  onboardingId  Int
  onboarding    Onboarding   @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  name          String
  email         String       @default("")
  role          String       @default("")
  magicLinks    MagicLink[]
  assignedTasks Task[]
  files         File[]
}

model Phase {
  id            Int        @id @default(autoincrement())
  onboardingId  Int
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int
  targetDate    DateTime?
  isComplete    Boolean    @default(false)
  tasks         Task[]
}

model Task {
  id              Int     @id @default(autoincrement())
  onboardingId    Int
  onboarding      Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  phaseId         Int
  phase           Phase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title           String
  description     String  @default("")
  status          String  // Not started | In progress | Under investigation | Blocked | Done
  due             String  // e.g. "2026-03-01"
  owner           String  @default("")
  ownerId         Int?
  ownerUser       VendorUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members         String[] @default([])
  notes           String  @default("")
  sortOrder       Int     @default(0)
  priority        String? // low | medium | high
  commentCount    Int     @default(0)
  previousStatus  String? // stores status before "Done" for toggle-back
  blockedByTaskId Int?
  blockedByTask      Task?    @relation("TaskBlocks", fields: [blockedByTaskId], references: [id], onDelete: SetNull)
  blockedTasks       Task[]   @relation("TaskBlocks")
  assigneeContactId  Int?
  assigneeContact    Contact? @relation(fields: [assigneeContactId], references: [id], onDelete: SetNull)
  comments           Comment[]
  files              File[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())
}

model MagicLink {
  id            Int        @id @default(autoincrement())
  token         String     @unique @default(uuid())
  contactId     Int
  contact       Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  onboardingId  Int
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime   @default(now())
  lastUsedAt    DateTime?
  sentAt        DateTime?
  sentTo        String?

  @@index([contactId])
}

model File {
  id            Int        @id @default(autoincrement())
  taskId        Int
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  onboardingId  Int
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  contactId     Int?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  uploadedBy    String
  fileName      String
  fileSize      Int
  mimeType      String
  storagePath   String
  createdAt     DateTime   @default(now())
}
