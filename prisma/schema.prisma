// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          Int           @id @default(autoincrement())
  name        String
  domain      String?       // Email domain (e.g. "acme.com"). Used to match Miniti meeting attendees → company.
  logoUrl     String?       // App-relative logo path (e.g. "/logos/fal.png"). Null → initials avatar fallback.
  prefix      String        @unique
  taskCounter Int           @default(0)
  onboardings Onboarding[]
  tasks       Task[]
}

model VendorUser {
  id               Int            @id @default(autoincrement())
  authUserId       String?        @unique
  email            String         @unique
  name             String
  role             String         @default("admin") // admin | member | viewer
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  ownedOnboardings Onboarding[]
  ownedTasks       Task[]
  activities       ActivityLog[]
  notifications    Notification[] @relation("NotificationRecipientVendor")
}

model ActivityLog {
  id             Int            @id @default(autoincrement())
  onboardingId   Int
  onboarding     Onboarding     @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  actorType      String         // "vendor" | "contact" | "system"
  actorVendorId  Int?
  actorVendor    VendorUser?    @relation(fields: [actorVendorId], references: [id], onDelete: SetNull)
  actorContactId Int?
  actorContact   Contact?       @relation(fields: [actorContactId], references: [id], onDelete: SetNull)
  verb           String         // created | completed | status_changed | assigned | commented | uploaded | link_activated | health_flipped
  entityType     String         // task | file | comment | onboarding | magic_link
  entityId       Int
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([onboardingId, createdAt])
  @@index([actorVendorId])
  @@index([actorContactId])
}

model Notification {
  id                 Int         @id @default(autoincrement())
  activityLogId      Int
  activityLog        ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  recipientType      String      // "vendor" | "contact"
  recipientVendorId  Int?
  recipientVendor    VendorUser? @relation("NotificationRecipientVendor", fields: [recipientVendorId], references: [id], onDelete: Cascade)
  recipientContactId Int?
  recipientContact   Contact?    @relation("NotificationRecipientContact", fields: [recipientContactId], references: [id], onDelete: Cascade)
  groupKey           String
  emailed            Boolean     @default(false)
  readAt             DateTime?
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())

  @@index([recipientVendorId, readAt])
  @@index([recipientContactId, readAt])
  @@index([groupKey])
}

model Onboarding {
  id             Int               @id @default(autoincrement())
  companyId      Int
  owner          String            @default("")
  ownerId        Int?
  ownerUser      VendorUser?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status         String            @default("Active") // Active | Completed | Paused | Archived
  targetGoLive   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks          Task[]
  contacts       Contact[]
  phases         Phase[]
  magicLinks     MagicLink[]
  files          File[]
  activities     ActivityLog[]
  externalEvents ExternalEvent[]
  pendingChanges PendingAIChange[]
}

model Contact {
  id               Int          @id @default(autoincrement())
  onboardingId     Int
  onboarding       Onboarding   @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  name             String
  email            String       @default("")
  role             String       @default("")
  lastSeenPortalAt DateTime?
  bouncedAt        DateTime?
  magicLinks       MagicLink[]
  assignedTasks    Task[]
  files            File[]
  activities       ActivityLog[]
  notifications    Notification[] @relation("NotificationRecipientContact")
}

model Phase {
  id            Int        @id @default(autoincrement())
  onboardingId  Int
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int
  targetDate    DateTime?
  isComplete    Boolean    @default(false)
  tasks         Task[]
}

model Task {
  id              Int     @id @default(autoincrement())
  onboardingId    Int
  onboarding      Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  phaseId         Int
  phase           Phase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title           String
  description     String  @default("")
  status          String  // Not started | In progress | Under investigation | On hold | Blocked | Done
  due             String  // e.g. "2026-03-01"
  owner           String  @default("")
  ownerId         Int?
  ownerUser       VendorUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members         String[] @default([])
  notes           String  @default("")
  sortOrder       Int     @default(0)
  priority        String? // low | medium | high
  commentCount    Int     @default(0)
  previousStatus  String? // stores status before "Done" for toggle-back
  blockedByTaskId Int?
  blockedByTask      Task?    @relation("TaskBlocks", fields: [blockedByTaskId], references: [id], onDelete: SetNull)
  blockedTasks       Task[]   @relation("TaskBlocks")
  assigneeContactId  Int?
  assigneeContact    Contact? @relation(fields: [assigneeContactId], references: [id], onDelete: SetNull)
  comments           Comment[]
  files              File[]
  number      Int
  companyId   Int
  company     Company    @relation(fields: [companyId], references: [id], onDelete: NoAction)
  createdAt   DateTime   @default(now())

  // Note: a CHECK constraint enforces Company.prefix ~ '^[A-Z][A-Z0-9]{1,4}$',
  // a CHECK constraint enforces Task.number > 0, and a Postgres trigger
  // (task_company_consistency) enforces Task.companyId = Onboarding.companyId.
  // These cannot be expressed in Prisma — see migration
  // 20260526164238_tighten_task_id_constraints.
  @@unique([companyId, number])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())
}

model MagicLink {
  id            Int        @id @default(autoincrement())
  token         String     @unique @default(uuid())
  contactId     Int
  contact       Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  onboardingId  Int
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime   @default(now())
  lastUsedAt    DateTime?
  sentAt        DateTime?
  sentTo        String?

  @@index([contactId])
}

model File {
  id            Int        @id @default(autoincrement())
  taskId        Int
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  onboardingId  Int
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  contactId     Int?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  uploadedBy    String
  fileName      String
  fileSize      Int
  mimeType      String
  storagePath   String
  createdAt     DateTime   @default(now())
}

// Append-only log of AI-generated insight summaries.
// "Latest" = MAX(generatedAt) for a given (scope, scopeId).
// scopeId is a string so it can hold either an onboarding ID or "portfolio".
model Insight {
  id           Int      @id @default(autoincrement())
  scope        String   // "onboarding" | "portfolio"
  scopeId      String
  contextHash  String   // digest of meaningful state at generation time
  payload      Json     // structured Claude response (headline, focus*, risks, wins, nudges, trend)
  model        String
  generatedAt  DateTime @default(now())
  durationMs   Int

  @@index([scope, scopeId, generatedAt])
}

// Raw events from external integrations (Miniti / Linear / Attio).
// Webhook handlers write here; orchestrator reads unprocessed rows.
model ExternalEvent {
  id             Int              @id @default(autoincrement())
  source         String           // "miniti" | "linear" | "attio"
  sourceId       String           // their event ID for idempotency / dedup
  occurredAt     DateTime
  receivedAt     DateTime         @default(now())
  processedAt    DateTime?
  payload        Json             // raw payload as received
  onboardingId   Int?
  onboarding     Onboarding?      @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  matchAmbiguous Boolean          @default(false)  // true → needs Caroline to assign manually
  isTestRun      Boolean          @default(false)  // fired from /admin/ai test panel — hide from per-onboarding Meetings, show with badge in admin Pipeline
  error          String?          // last processing error, if any
  // Debug surface for orchestrator iteration. Two-pass pipeline writes:
  //   - orchestratorInput      = JSON we sent to Claude (buildOrchestratorContext output)
  //   - orchestratorExtraction = Pass 1 structured facts (action items, mentions, completions)
  //   - orchestratorOutput     = Pass 2 raw tool calls (create_task / match_existing / ...)
  // All nullable because pre-existing rows + ambiguous events never reach
  // the orchestrator.
  orchestratorInput      Json?
  orchestratorExtraction Json?
  orchestratorOutput     Json?
  pendingChanges PendingAIChange[]

  @@unique([source, sourceId])
  @@index([processedAt])
  @@index([onboardingId])
}

// Drafts of AI-proposed changes — the "Vector suggests" inbox.
// Approved drafts execute via existing createTask / updateTask paths.
model PendingAIChange {
  id             Int            @id @default(autoincrement())
  source         String         // "miniti" | "linear" | "attio" | "insights"
  sourceEventId  Int?
  sourceEvent    ExternalEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  onboardingId   Int
  onboarding     Onboarding     @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  action         String         // "create_task" | "match_existing" | "update_status" | "reassign" | "reprioritise"
  payload        Json           // proposed change — tool call arguments
  sourceQuote    String?        // transcript snippet / event description that justified it
  sourceUrl      String?        // link back to original (Miniti URL, Linear issue link, etc.)
  confidence     String         // "low" | "medium" | "high"
  status         String         @default("pending")  // pending | approved | rejected | applied
  rejectedReason String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?
  resolvedBy     Int?           // VendorUser.id who approved / rejected
  appliedTaskId  Int?           // if applied → which task was created/updated

  @@index([onboardingId, status])
  @@index([status, createdAt])
}

// Stores connection status + secrets per integration source.
model IntegrationConnection {
  id           Int       @id @default(autoincrement())
  source       String    @unique  // "miniti" | "linear" | "attio"
  status       String    @default("connected")  // connected | disconnected | error
  config       Json      // source-specific (webhook secret, account ID, etc.)
  connectedAt  DateTime  @default(now())
  lastEventAt  DateTime?

  @@index([status])
}

// Append-only log of every Claude API call — feeds the cost/observability dashboard.
model AICall {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  kind             String   // "insight_onboarding" | "insight_portfolio" | "transcript" | …
  scopeId          String?
  model            String
  inputTokens      Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  outputTokens     Int
  costUsd          Decimal  @db.Decimal(10, 6)
  durationMs       Int
  error            String?
  requestId        String?  // Anthropic request_id for cross-referencing in their dashboard

  @@index([kind, createdAt])
}
